# ==============================================================================
# BOLTI KITAB (بولتی کتاب) - PHASE 1 ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with local development / deployment secrets.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE (POSTGRESQL 16)
# Local development default: bolti_kitab_dev with user postgres
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/bolti_kitab_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bolti_kitab_dev
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (RS256 JWT & ARGON2ID)
#
# Generate keys by running from backend/:
#   npm run generate-keys
#
# This writes JWT_PRIVATE_KEY and JWT_PUBLIC_KEY to backend/.env automatically.
# backend/.env is git-ignored — keys are NEVER committed to version control.
#
# PEM keys are stored with literal \n sequences (the generate-keys script handles this).
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...PKCS8 private key...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...SPKI public key...\n-----END PUBLIC KEY-----"
JWT_EXPIRES_IN=1h
JWT_ISSUER=bolti-kitab
JWT_AUDIENCE=bolti-kitab-client

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (DIRECT CLOUD STREAMING)
# Target: Azure Blob Storage (Primary). Fallback: Vultr Object Storage (S3 API).
# Direct streaming pattern: backend issues short-lived SAS / Presigned URLs.
# Backend NEVER proxies audio byte streams.
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=azure

# Azure Blob Storage (Primary)
AZURE_STORAGE_ACCOUNT_NAME=boltitabdevstorage
AZURE_STORAGE_ACCOUNT_KEY=your_azure_storage_account_key
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=boltitabdevstorage;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_CONTAINER_AUDIO_PRIVATE=audio-private
AZURE_CONTAINER_COVERS_PUBLIC=covers-public
AZURE_SAS_PLAYBACK_EXPIRATION_SECONDS=3600
AZURE_SAS_UPLOAD_EXPIRATION_SECONDS=1800

# Vultr Object Storage (S3-Compatible Alternative / Portability Target)
VULTR_STORAGE_ENDPOINT=https://ewr1.vultrobjects.com
VULTR_STORAGE_REGION=ewr1
VULTR_STORAGE_BUCKET=bolti-kitab-audio
VULTR_STORAGE_ACCESS_KEY=your_vultr_access_key
VULTR_STORAGE_SECRET_KEY=your_vultr_secret_key

# ------------------------------------------------------------------------------
# 5. WEBSOCKET REAL-TIME HUB
# Path: /ws/v1/channels
# ------------------------------------------------------------------------------
WS_PATH=/ws/v1/channels
WS_HEARTBEAT_INTERVAL_MS=30000
WS_INACTIVITY_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS & WEBHOOKS
# Supported in Phase 1: Stripe (Cards), JazzCash (PKR), EasyPaisa (PKR)
# ------------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JazzCash (Local Pakistan Mobile Wallet)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:3000/checkout/jazzcash/callback

# EasyPaisa (Local Pakistan Mobile Wallet)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_POST_BACK_URL=http://localhost:3000/checkout/easypaisa/callback

# ------------------------------------------------------------------------------
# 7. AUDIO RECORDING & FFPROBE VALIDATION (STUDIO)
# ------------------------------------------------------------------------------
AUDIO_REQUIRED_SAMPLE_RATE_HZ=44100
AUDIO_REQUIRED_CHANNELS=2
AUDIO_MAX_TAKE_SIZE_BYTES=524288000
FFPROBE_BINARY_PATH=ffprobe
