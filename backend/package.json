{
  "name": "bolti-kitab-backend",
  "version": "1.0.0",
  "description": "Bolti Kitab (بولتی کتاب) — Phase 1 Backend Modular Monolith",
  "author": "Bolti Kitab Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "generate-keys": "tsx scripts/generate-keys.ts",
    "test": "tsx --import ./src/test/setup-env.ts --test --test-concurrency=1 src/**/*.test.ts",
    "test:auth": "tsx --import ./src/test/setup-env.ts --test src/modules/auth/auth.test.ts",
    "test:catalog": "tsx --import ./src/test/setup-env.ts --test src/modules/catalog/catalog.test.ts",
    "test:recordings": "tsx --import ./src/test/setup-env.ts --test src/modules/recordings/recordings.test.ts",
    "test:playback": "tsx --import ./src/test/setup-env.ts --test src/modules/playback/playback.test.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "ingest": "tsx scripts/ingest-real-audio.ts",
    "test:storage:b2": "tsx scripts/test-b2-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.33.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/sensible": "^6.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.45.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.15.6",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.11.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
